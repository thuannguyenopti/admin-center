#!/usr/bin/env bash
set -euo pipefail

usage() {
	echo "Usage: axiomplay install" >&2
	exit 1
}

CMD=${1:-}
if [[ "$CMD" != "install" ]]; then
	usage
fi

ROOT="$(cd "$(dirname "$0")" && pwd)"

# If running under a Windows-y shell, delegate to the .bat
if [[ "${OS:-}" == "Windows_NT" || -n "${WINDIR:-}" || -n "${MSYSTEM:-}" ]]; then
	cmd //c "\"$ROOT\\install.bat\""
	exit $?
fi

chmod +x "$ROOT/install.sh" >/dev/null 2>&1 || true
"$ROOT/install.sh"
