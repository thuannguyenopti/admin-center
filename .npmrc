# Optimizely registry for @optimizely scoped packages (e.g. @optimizely/axiom-icons)
# Auth is read from environment: OPTIMIZELY_USERNAME, OPTIMIZELY_PASSWORD (set via .env when using npm run install:auth)
@optimizely:registry=https://optimizely.jfrog.io/artifactory/api/npm/npm/
//optimizely.jfrog.io/artifactory/api/npm/npm/:_password=${OPTIMIZELY_PASSWORD}
//optimizely.jfrog.io/artifactory/api/npm/npm/:username=${OPTIMIZELY_USERNAME}
//optimizely.jfrog.io/artifactory/api/npm/npm/:email=eng@optimizely.com
