# Optimizely registry for @optimizely scoped packages (e.g. @optimizely/axiom-icons).
# Do NOT interpolate ${OPTIMIZELY_PASSWORD} here — Yarn classic fails the whole
# build when that env var is unset (common on personal Vercel).
#
# Auth for the private registry (local / team CI):
#   Yarn 4 → set OPTIMIZELY_AUTH_IDENT (see .yarnrc.yml)
#   npm    → yarn install:auth (writes credentials from .env)
@optimizely:registry=https://optimizely.jfrog.io/artifactory/api/npm/npm/
