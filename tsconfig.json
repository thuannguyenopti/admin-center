{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@optimizely/axiom-icons": [
        "./node_modules/@optimizely/axiom-icons"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "temp-stride-source",
    "app/components/Opal/editor/multi-editor.ts",
    "app/components/Opal/editor/toolbar",
    "app/components/Opal/editor/collab",
    "app/components/Opal/editor/bindings",
    "app/components/Opal/editor/handlers",
    "app/components/Opal/editor/blame-coordinator.ts",
    "app/components/Opal/editor/blame-cm-extension.ts",
    "app/components/Opal/editor/blame-engine.ts",
    "app/components/Opal/editor/blame-tiptap-plugin.ts",
    "app/components/Opal/editor/collab-provider.ts",
    "app/components/Opal/editor/comment-cm-extension.ts",
    "app/components/Opal/editor/comment-coordinator.ts",
    "app/components/Opal/editor/comment-engine.ts",
    "app/components/Opal/editor/comment-tiptap-plugin.ts",
    "app/components/Opal/editor/suggest-engine.ts",
    "app/components/Opal/editor/text-binding.ts",
    "app/components/Opal/editor/version-coordinator.ts",
    "app/components/Opal/editor/doc-replicator.ts",
    "app/components/Opal/editor/diff-engine.ts",
    "app/components/Opal/editor/local-version-manager.ts",
    "app/components/Opal/editor/debug-log.ts",
    "app/components/Opal/editor/collab-cursor-plugin.ts"
  ]
}
