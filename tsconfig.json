{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@optimizely/axiom-icons": [
        "./node_modules/@optimizely/axiom-icons"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "temp-stride-source",
    "app/components/Opal/editor/multi-editor.ts",
    "app/components/Opal/editor/toolbar/editor-toolbar.ts",
    "app/components/Opal/editor/toolbar/editor-status-bar.ts",
    "app/components/Opal/editor/toolbar/comment-panel.ts",
    "app/components/Opal/editor/toolbar/comment-list-panel.ts",
    "app/components/Opal/editor/toolbar/suggest-status.ts",
    "app/components/Opal/editor/toolbar/version-panel.ts"
  ]
}
