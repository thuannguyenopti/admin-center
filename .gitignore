# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# lock files (using yarn)
package-lock.json
bun.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
yarn.lock
.env*.local

# code viewer source bundle (auto-generated during build)
/public/source-bundle.json
.envrc
# .claude — ignore sensitive local files but track shared agent skills
.claude/*.json
.claude/*.sh
.claude/worktrees/
.claude/settings*.json
.claude/mcp.json
.cursor/
.vscode/
logs/*.log*

# IM mock backend data store
.messaging-data.json
# IM mock backend uploads
/public/im-uploads/
config.bat
