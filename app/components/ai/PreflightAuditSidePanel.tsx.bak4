"use client";

import React, {useState, useEffect, useCallback} from "react";
import {
	Box,
	Text,
	Heading,
	Badge,
	Button,
	Checkbox,
	Spinner,
	Skeleton,
	Card,
	Disclosure,
	DisclosureTrigger,
	DisclosureContent,
} from "@optiaxiom/react";
import {
	IconCheck,
	IconAlertCircle,
	IconClipboardCheck,
	IconX,
	IconAlertTriangle,
} from "@tabler/icons-react";
import usePersistentState from "@/app/usePersistentState";
import type {
	PreflightAuditResult,
	PreflightAuditIssue,
	AuditIssueType,
} from "./PreflightAuditTypes";
import {AuditTypeLabels, SeverityIntent, SeverityOrder} from "./PreflightAuditTypes";

interface PreflightAuditSidePanelProps {
	result: PreflightAuditResult | null;
	isLoading: boolean;
	onClose: () => void;
	onApply?: (suggestion: string, fieldId?: string) => void;
	onApplyAll?: (changes: Array<{fieldId: string; suggestion: string}>) => void;
	onSelectField?: (fieldId: string) => void;
}

export const PreflightAuditSidePanel: React.FC<PreflightAuditSidePanelProps> = ({
	result,
	isLoading,
	onClose,
	onApply,
	onApplyAll,
	onSelectField,
}) => {
	const [panelWidth, setPanelWidth] = usePersistentState("preflightAuditPanelWidth", 384);
	const [isResizing, setIsResizing] = useState(false);
	const [isMobile, setIsMobile] = useState(false);
	const [isResizeHandleHovered, setIsResizeHandleHovered] = useState(false);

	// Detect mobile screen size
	useEffect(() => {
		const checkMobile = () => {
			setIsMobile(window.innerWidth < 768);
		};

		checkMobile();
		window.addEventListener("resize", checkMobile);

		return () => window.removeEventListener("resize", checkMobile);
	}, []);

	const hasFieldLevelIssues = result?.issues.some((issue) => issue.fieldId);
	const canApplyAll = hasFieldLevelIssues && onApplyAll && result && result.issues.length > 0;

	// Checkbox state - start with all checked by default
	const [checkedIssues, setCheckedIssues] = useState<Set<number>>(new Set());

	// Track which issues have been applied
	const [appliedIssues, setAppliedIssues] = useState<Set<number>>(new Set());

	// Reset checkboxes and applied issues when result changes
	// Select all issues with fieldId by default
	useEffect(() => {
		if (result) {
			const allFieldIssues = new Set<number>();
			result.issues.forEach((issue, index) => {
				if (issue.fieldId) {
					allFieldIssues.add(index);
				}
			});
			setCheckedIssues(allFieldIssues);
		}
		setAppliedIssues(new Set());
	}, [result]);

	// Resize handlers
	const handleMouseDown = useCallback((e: React.MouseEvent) => {
		e.preventDefault();
		setIsResizing(true);
	}, []);

	useEffect(() => {
		if (!isResizing) return;

		const handleMouseMove = (e: MouseEvent) => {
			const newWidth = window.innerWidth - e.clientX;
			// Constrain width between 320-480px
			const constrainedWidth = Math.min(Math.max(newWidth, 320), 480);
			setPanelWidth(constrainedWidth);
		};

		const handleMouseUp = () => {
			setIsResizing(false);
		};

		document.addEventListener("mousemove", handleMouseMove);
		document.addEventListener("mouseup", handleMouseUp);

		return () => {
			document.removeEventListener("mousemove", handleMouseMove);
			document.removeEventListener("mouseup", handleMouseUp);
		};
	}, [isResizing, setPanelWidth]);

	const handleIssueCardClick = useCallback(
		(fieldId?: string) => {
			console.log("[PreflightAuditSidePanel] Issue card clicked:", {
				fieldId,
				hasOnSelectField: !!onSelectField,
			});

			if (fieldId && onSelectField) {
				console.log("[PreflightAuditSidePanel] Calling onSelectField with:", fieldId);
				onSelectField(fieldId);
			} else {
				console.log("[PreflightAuditSidePanel] Not calling onSelectField:", {
					hasFieldId: !!fieldId,
					hasOnSelectField: !!onSelectField,
				});
			}
		},
		[onSelectField]
	);

	const handleApplyClick = useCallback(
		(index: number, suggestion: string, fieldId?: string) => {
			if (onApply) {
				onApply(suggestion, fieldId);
				setAppliedIssues((prev) => new Set(prev).add(index));
			}
		},
		[onApply]
	);

	const handleApplyAllClick = useCallback(() => {
		if (!result || !onApplyAll) return;

		const changes = result.issues
			.filter(
				(issue, index) => issue.fieldId && checkedIssues.has(index) && !appliedIssues.has(index)
			)
			.map((issue) => ({
				fieldId: issue.fieldId!,
				suggestion: issue.suggestion,
			}));

		if (changes.length > 0) {
			onApplyAll(changes);

			// Mark all checked issues as applied
			setAppliedIssues((prev) => {
				const newApplied = new Set(prev);
				result.issues.forEach((issue, index) => {
					if (issue.fieldId && checkedIssues.has(index)) {
						newApplied.add(index);
					}
				});
				return newApplied;
			});
		}
	}, [result, onApplyAll, checkedIssues, appliedIssues]);

	// Group issues by audit type
	const groupedIssues =
		result?.issues.reduce(
			(groups, issue, index) => {
				if (!groups[issue.type]) {
					groups[issue.type] = [];
				}
				groups[issue.type].push({issue, originalIndex: index});
				return groups;
			},
			{} as Record<AuditIssueType, Array<{issue: PreflightAuditIssue; originalIndex: number}>>
		) || {};

	// Sort groups by severity and count
	const sortedGroupKeys = Object.keys(groupedIssues).sort((a, b) => {
		const typeA = a as AuditIssueType;
		const typeB = b as AuditIssueType;

		// Find highest severity in each group
		const maxSeverityA = Math.min(
			...groupedIssues[typeA].map((item) => SeverityOrder[item.issue.severity])
		);
		const maxSeverityB = Math.min(
			...groupedIssues[typeB].map((item) => SeverityOrder[item.issue.severity])
		);

		return maxSeverityA - maxSeverityB;
	}) as AuditIssueType[];

	return (
		<Box
			borderL="1"
			borderColor="border.tertiary"
			bg="bg.default"
			h="full"
			display="flex"
			flexDirection="column"
			style={{
				width: isMobile ? "100vw" : `${panelWidth}px`,
				minWidth: isMobile ? "100vw" : `${panelWidth}px`,
				position: isMobile ? "fixed" : "relative",
				top: isMobile ? 0 : undefined,
				left: isMobile ? 0 : undefined,
				zIndex: isMobile ? 1000 : undefined,
			}}
		>
			{/* Resize Handle - hidden on mobile */}
			{!isMobile && (
				<Box
					style={{
						position: "absolute",
						left: 0,
						top: 0,
						bottom: 0,
						width: "4px",
						cursor: "ew-resize",
						zIndex: 100,
					}}
					onMouseDown={handleMouseDown}
				>
					<div
						style={{
							position: "absolute",
							left: "1px",
							top: 0,
							bottom: 0,
							width: "2px",
							backgroundColor: (isResizing || isResizeHandleHovered) ? "var(--ax-colors-border-accent)" : "transparent",
							transition: "background-color 0.2s",
						}}
						onMouseEnter={() => setIsResizeHandleHovered(true)}
						onMouseLeave={() => setIsResizeHandleHovered(false)}
					/>
				</Box>
			)}

			{/* Header */}
			<Box
				p="16"
				borderB="1"
				borderColor="border.tertiary"
				display="flex"
				alignItems="center"
				justifyContent="space-between"
				flexShrink={0}
			>
				<Box display="flex" alignItems="center" gap="8">
					{result && (
						<>
							{result.criticalCount > 0 && (
								<Badge variant="subtle" intent="danger">
									{result.criticalCount} Critical
								</Badge>
							)}
							{result.highCount > 0 && (
								<Badge variant="subtle" intent="danger">
									{result.highCount} High
								</Badge>
							)}
						</>
					)}
					<Box display="flex" alignItems="center" gap="8">
						<IconClipboardCheck size={20} />
						<Text fontWeight="600">Preflight Audit</Text>
					</Box>
				</Box>
				<Button
					appearance="subtle"
					size="sm"
					icon={<IconX size={16} />}
					onClick={onClose}
					aria-label="Close"
				/>
			</Box>

			{/* Body (scrollable) */}
			<Box flex="1" overflow="auto" p="16">
				{isLoading && (
					<Box display="flex" flexDirection="column" gap="16">
						<Box display="flex" alignItems="center" justifyContent="center" gap="12" py="24">
							<Spinner />
							<Text color="fg.secondary">Running preflight checks...</Text>
						</Box>
						<Skeleton h="80" rounded="md" />
						<Skeleton h="64" rounded="md" />
						<Skeleton h="224" rounded="md" />
					</Box>
				)}

				{!isLoading && result && (
					<Box display="flex" flexDirection="column" gap="24">
						{/* Summary Card */}
						<Card
							display="flex"
							flexDirection="column"
							gap="12"
							p="16"
							bg="bg.secondary"
						>
							<Box display="flex" alignItems="center" gap="8">
								{result.totalIssues === 0 ? (
									<IconCheck size={24} color="var(--ax-colors-fg-success)" />
								) : result.criticalCount > 0 ? (
									<IconAlertCircle size={24} color="var(--ax-colors-fg-danger)" />
								) : (
									<IconAlertTriangle size={24} color="var(--ax-colors-fg-warning)" />
								)}
								<Heading level="4" fontSize="md" fontWeight="700">
									{result.totalIssues === 0
										? "All Checks Passed"
										: `${result.totalIssues} Issue${result.totalIssues !== 1 ? "s" : ""} Found`}
								</Heading>
							</Box>
							<Text fontSize="sm" color="fg.secondary">
								{result.summary}
							</Text>
						</Card>

						{/* Issues Grouped by Audit Type */}
						{sortedGroupKeys.length > 0 &&
							sortedGroupKeys.map((auditType) => {
								const group = groupedIssues[auditType];
								const groupLabel = AuditTypeLabels[auditType];

								return (
									<Disclosure key={auditType} defaultOpen>
										<DisclosureTrigger asChild>
											<Button appearance="subtle" w="full" justifyContent="start" px="0">
												<Heading level="4" fontSize="md">
													{groupLabel} ({group.length})
												</Heading>
											</Button>
										</DisclosureTrigger>
										<DisclosureContent>
											<Box display="flex" flexDirection="column" gap="12" mt="8">
												{group.map(({issue, originalIndex}) => {
													const isChecked = checkedIssues.has(originalIndex);
													const isApplied = appliedIssues.has(originalIndex);
													const isClickable = issue.fieldId && onSelectField;

													return (
														<Card
															key={originalIndex}
															p="12"
															border="1"
															borderColor={
																isApplied
																	? "border.success"
																	: isChecked
																		? "border.accent"
																		: "border.default"
															}
															style={{
																cursor: isClickable ? "pointer" : "default",
																opacity: isApplied ? 0.7 : 1,
															}}
															onClick={() => handleIssueCardClick(issue.fieldId)}
														>
															<Box display="flex" alignItems="center" gap="8" mb="8">
																{isApplied ? (
																	<Box display="flex" alignItems="center" gap="4">
																		<IconCheck size={16} color="var(--ax-colors-fg-success)" />
																		<Badge variant="subtle" intent="success">
																			Applied
																		</Badge>
																	</Box>
																) : (
																	canApplyAll && (
																		<Checkbox
																			checked={isChecked}
																			onClick={(e) => e.stopPropagation()}
																			onChange={(e) => {
																				e.stopPropagation();
																				const newChecked = new Set(checkedIssues);
																				if (e.currentTarget.checked) {
																					newChecked.add(originalIndex);
																				} else {
																					newChecked.delete(originalIndex);
																				}
																				setCheckedIssues(newChecked);
																			}}
																		/>
																	)
																)}
																<Badge
																	variant={issue.severity === "critical" ? "default" : "subtle"}
																	intent={SeverityIntent[issue.severity]}
																>
																	{issue.severity}
																</Badge>
																{issue.fieldLabel && (
																	<Badge variant="subtle" intent="neutral">
																		{issue.fieldLabel}
																	</Badge>
																)}
															</Box>
															<Box mb="12">
																<Text fontSize="sm" fontWeight="500" mb="4">
																	<IconAlertCircle
																		size={14}
																		style={{display: "inline", marginRight: "4px"}}
																	/>
																	{issue.message}
																</Text>
															</Box>
															<Box display="flex" flexDirection="column" gap="8">
																{issue.original && (
																	<Box>
																		<Text fontSize="xs" color="fg.secondary" mb="2">
																			Original:
																		</Text>
																		<Box
																			p="8"
																			bg={isApplied ? "bg.default" : "bg.error.subtle"}
																			fontSize="md"
																			color="fg.default"
																		rounded="md"
																		border="1"
																		borderColor="border.default"
																		>
																			{issue.original}
																		</Card>
																	</Box>
																)}
																<Box>
																	<Text fontSize="xs" color="fg.secondary" mb="2">
																		{isApplied ? "Applied:" : "Suggestion:"}
																	</Text>
																	<Box
																		display="flex"
																		alignItems="center"
																		justifyContent="space-between"
																		gap="8"
																	>
																		<Card
																			flex="1"
																			p="8"
																			bg={isApplied ? "bg.default" : "bg.success.subtle"}
																			fontSize="md"
																			color="fg.default"
																		>
																			{issue.suggestion}
																		</Card>
																		{onApply && !isApplied && issue.fieldId && (
																			<Button
																				size="sm"
																				appearance="primary"
																				onClick={(e) => {
																					e.stopPropagation();
																					handleApplyClick(
																						originalIndex,
																						issue.suggestion,
																						issue.fieldId
																					);
																				}}
																			>
																				Apply
																			</Button>
																		)}
																		{isApplied && (
																			<Box display="flex" alignItems="center" gap="4" px="8">
																				<IconCheck size={16} color="var(--ax-colors-fg-success)" />
																			</Box>
																		)}
																	</Box>
																</Box>
															</Box>
														</Card>
													);
												})}
											</Box>
										</DisclosureContent>
									</Disclosure>
								);
							})}

						{/* No Issues State */}
						{result.issues.length === 0 && (
							<Box
								display="flex"
								flexDirection="column"
								alignItems="center"
								gap="8"
								py="32"
							>
								<IconCheck size={48} color="var(--ax-colors-fg-success)" />
								<Heading level="4">Ready to Publish!</Heading>
								<Text color="fg.secondary" textAlign="center">
									No critical or high-priority issues found. Your content looks good.
								</Text>
							</Box>
						)}
					</Box>
				)}
			</Box>

			{/* Footer (sticky) */}
			{!isLoading &&
				result &&
				(() => {
					// Calculate how many checked issues are not yet applied
					const unappliedCheckedCount = Array.from(checkedIssues).filter(
						(index) => !appliedIssues.has(index)
					).length;

					const showApplyButton = canApplyAll && unappliedCheckedCount > 0;

					return (
						<Box
							p="16"
							borderT="1"
							borderColor="border.tertiary"
							bg="bg.default"
							display="flex"
							justifyContent="flex-end"
							gap="8"
							flexShrink={0}
						>
							<Button appearance="subtle" onClick={onClose}>
								Close
							</Button>
							{showApplyButton && (
								<Button appearance="primary" onClick={handleApplyAllClick}>
									Apply {unappliedCheckedCount} Change{unappliedCheckedCount !== 1 ? "s" : ""}
								</Button>
							)}
						</Box>
					);
				})()}
		</Box>
	);
};
